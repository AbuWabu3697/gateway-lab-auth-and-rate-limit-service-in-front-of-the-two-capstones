# Gateway configuration — fill in values as needed for your environment

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT verification
JWKS_URI=https://your-auth-server/.well-known/jwks.json
JWKS_CACHE_TTL_MS=300000
JWT_AUDIENCE=gateway
JWT_ISSUER=https://your-auth-server

# Redis (token-bucket rate limiter)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_WINDOW_SECS=60

# Upstream services
LEDGER_UPSTREAM=http://ledger-service.internal:8080
NOTIFY_UPSTREAM=http://notify-service.internal:8080

# Circuit breaker
CB_WINDOW_SIZE=10
CB_ERROR_THRESHOLD=0.5
CB_OPEN_DURATION_MS=30000
